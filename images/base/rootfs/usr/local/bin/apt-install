#!/bin/sh

if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: apt-install must run as root; switch to USER root before invoking it" >&2
    exit 1
fi

if [ "$#" -eq 0 ]; then
    echo "usage: apt-install <package> [<package> ...]" >&2
    exit 1
fi

for package do
    if [ -z "$package" ]; then
        echo "ERROR: apt-install package names must not be empty" >&2
        exit 1
    fi
done

apt-get update || exit $?
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$@"
exit_code=$?
rm -rf /var/lib/apt/lists/*
exit $exit_code
